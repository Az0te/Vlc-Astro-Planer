{
  "packageId": "com.vlc.astroplaner",
  "host": "vlc-astroplaner.web.app",
  "name": "Vlc AstroPlaner",
  "launcherName": "VlcAstro",
  "themeColor": "#090d16",
  "navigationColor": "#070a12",
  "backgroundColor": "#070a12",
  "enableNotifications": false,
  "startUrl": "/",
  "iconUrl": "/pwa-512x512.png",
